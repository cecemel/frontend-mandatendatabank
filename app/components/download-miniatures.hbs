<div class="au-o-grid au-u-margin-bottom">
  {{#if this.csvFile}}
    <div class="au-o-grid__item au-u-1-1 au-u-1-2@medium">
      <au-wc-card flex divided>
        <au-wc-card-header badge-skin="brand" badge-icon="download">
          <div>
            <AuHeading @level="2" @skin="4">
              Download in CSV formaat
            </AuHeading>
            <p>Voor spreadsheet editors zoals Excel of Numbers.</p>
          </div>
        </au-wc-card-header>
        <au-wc-card-content>
          <AuLinkExternal @icon="download" @skin="button" href={{this.downloadLink this.csvFile}} download>
            Download in CSV formaat
          </AuLinkExternal>
          <AuHelpText>{{this.csvMetadata}}</AuHelpText>
        </au-wc-card-content>
      </au-wc-card>
    </div>
  {{else}}
    <div class="au-o-grid__item au-u-1-1 au-u-1-2@medium">
      <au-wc-card flex divided>
        <au-wc-card-header badge-skin="brand" badge-icon="download">
          <div>
            <AuHeading @level="2" @skin="4">
              Download in CSV formaat
            </AuHeading>
            <p>Voor spreadsheet editors zoals Excel of Numbers.</p>
          </div>
        </au-wc-card-header>
        <au-wc-card-content>
          <AuHelpText>Momenteel niet beschikbaar</AuHelpText>
        </au-wc-card-content>
      </au-wc-card>
    </div>
  {{/if}}
  {{#if this.ttlFile}}
    <div class="au-o-grid__item au-u-1-1 au-u-1-2@medium">
      <au-wc-card flex divided>
        <au-wc-card-header badge-skin="brand" badge-icon="download">
          <div>
            <AuHeading @level="2" @skin="4">
              Download in Turtle formaat
            </AuHeading>
            <p>Gestructureerde data voor dataverwerking en analyse</p>
          </div>
        </au-wc-card-header>
        <au-wc-card-content>
          <AuLinkExternal @icon="download" @skin="button" href={{this.downloadLink this.ttlFile}} download>
            Download in Turtle formaat
          </AuLinkExternal>
          <AuHelpText>{{this.ttlMetadata}}</AuHelpText>
        </au-wc-card-content>
      </au-wc-card>
    </div>
  {{else}}
    <div class="au-o-grid__item au-u-1-1 au-u-1-2@medium">
      <au-wc-card flex divided>
        <au-wc-card-header badge-skin="brand" badge-icon="download">
          <div>
            <AuHeading @level="2" @skin="4">
              Download in Turtle formaat
            </AuHeading>
            <p>Gestructureerde data voor dataverwerking en analyse</p>
          </div>
        </au-wc-card-header>
        <au-wc-card-content>
          <AuHelpText>Momenteel niet beschikbaar</AuHelpText>
        </au-wc-card-content>
      </au-wc-card>
    </div>
  {{/if}}
</div>
