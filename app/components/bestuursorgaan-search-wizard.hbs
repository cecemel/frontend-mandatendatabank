<div class="au-o-flow">
  <au-wc-card flex id="bestuursorgaan-search-wizard-step-1" class="bestuursorgaan-search-wizard-scroll-offset">
    <au-wc-card-header badge-skin={{if this.werkingsgebied "success" "action"}} badge-icon={{if this.werkingsgebied "check"}} badge-number={{unless this.werkingsgebied "1"}}>
      <div>
        <au-wc-heading level="2" skin="4" id="describe-search">
          Stap 1: Zoek een gemeente, provincie of district.
        </au-wc-heading>
      </div>
    </au-wc-card-header>
    <au-wc-card-content>
      <div style="position: relative; overflow: hidden;" {{!template-lint-disable no-inline-styles}}>
        <PowerSelect
          @ariaLabel="Zoekbalk"
          @ariaDescribedBy="describe-search"
          @allowClear={{true}}
          @searchEnabled={{true}}
          @disabled={{this.disabled}}
          @search={{perform @searchTask}}
          @selected={{this.werkingsgebied}}
          @loadingMessage="Aan het laden..."
          @searchMessage="Typ om te zoeken"
          @noMatchesMessage="Geen resultaten"
          @onChange={{this.listBestuurseenheden}} as |gebied|>
          {{gebied.longName}}
        </PowerSelect>
      </div>
      <au-wc-help-text>Oost-Vlaanderen, Berchem, Hasselt, ...</au-wc-help-text>
    </au-wc-card-content>
  </au-wc-card>

  <au-wc-card flex id="bestuursorgaan-search-wizard-step-2" class="bestuursorgaan-search-wizard-scroll-offset">
    <au-wc-card-header badge-icon={{if this.bestuursorganen "check"}}
      badge-number={{unless this.bestuursorganen "2"}}
      badge-skin={{if this.bestuursorganen "success" "action"}}>
      <div>
        <au-wc-heading level="2" skin="4">
          Stap 2: Kies een bestuurseenheid
        </au-wc-heading>
        {{#unless this.werkingsgebied}}
        <p>Kies eerst een gemeente, provincie of district.</p>
        {{/unless}}
      </div>
    </au-wc-card-header>
    {{#if @isLoadingBestuurseenheden}}
      <au-wc-card-content>
        <au-wc-loader class="au-u-margin-bottom-huge">Bestuurseenheden aan het laden</au-wc-loader>
      </au-wc-card-content>
    {{else if this.werkingsgebied}}
      <au-wc-card-content>
        <div class="au-o-grid au-o-grid--fixed">
          {{#each this.bestuurseenheden as |eenheid|}}
            <div class="au-o-grid__item au-u-1-1 au-u-1-2@medium au-u-1-3@large">
              <OrganisationCard
                @organisationId={{eenheid.id }}
                @isSelected={{eq @selectedBestuurseenheidId eenheid.id}}
                @classification={{eenheid.classificatie.label}}
                @name={{concat eenheid.classificatie.label " " eenheid.naam}}
                @onSelect={{this.listBestuursorganen}}
              />
            </div>
          {{/each}}
        </div>
      </au-wc-card-content>
    {{/if}}
  </au-wc-card>

  <au-wc-card flex id="bestuursorgaan-search-wizard-step-3" class="bestuursorgaan-search-wizard-scroll-offset">
    <au-wc-card-header badge-number="3" badge-skin="action">
      <div>
        <au-wc-heading level="2" skin="4">
          Stap 3: Kies een bestuursorgaan
        </au-wc-heading>
        {{#unless this.bestuursorganen}}
        <p>Kies eerst een bestuurseenheid.</p>
        {{/unless}}
      </div>
    </au-wc-card-header>
    {{#if @isLoadingBestuursorganen}}
      <au-wc-card-content>
        <au-wc-loader class="au-u-margin-bottom-huge">Bestuursorganen aan het laden</au-wc-loader>
      </au-wc-card-content>
    {{else if this.bestuursorganen}}
      <au-wc-card-content>
        <div class="au-o-grid au-o-grid--fixed">
          {{#each this.bestuursorganen as |orgaan|}}
            <div class="au-o-grid__item au-u-1-1 au-u-1-2@medium">
              <OrganisationCard
                @name={{orgaan.naam}}
              >
                <:button>
                  <LinkTo
                    @route="bestuursorgaan.subject"
                    @model={{orgaan.id}}
                    class="au-wc-button au-wc-button--primary au-wc-button--large au-wc-button--block au-wc-button--wrap"
                  >
                    Kies {{orgaan.classificatie.label}}
                  </LinkTo>
                </:button>
              </OrganisationCard>
            </div>
          {{/each}}
        </div>
      </au-wc-card-content>
    {{/if}}
  </au-wc-card>
</div>
