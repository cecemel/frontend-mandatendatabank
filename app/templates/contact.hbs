<au-wc-content-header title-part-one="Vlaanderen" title-part-two="mandatendatabank" picture-size="large">
  <img sizes="50vw" src="/assets/images/loket-header-1600-85a5251e74ef6ac8491b2f228d2c90da.jpg" srcset="/assets/images/banner-bruges-320.jpg 320w, /assets/images/banner-bruges-1024.jpg 1024w, /assets/images/banner-bruges-1600.jpg 1600w" alt="">
</au-wc-content-header>

<div class="au-o-layout">
  <div class="au-o-region-large">
    <au-wc-heading level="1" skin="2" class="au-u-margin-bottom-small">
      Contact
    </au-wc-heading>

    <form class="au-c-form au-u-margin-bottom-large">
      <fieldset class="au-wc-fieldset">
        <legend class="au-wc-fieldset-legend">
          Waar gaat uw bericht over?
        </legend>
        <div class="au-wc-fieldset-content">
          <div class="au-wc-radio-group">
            <label class="au-wc-radio">
              <input
                type="radio"
                name="contact-subject"
                value="LoketLokaalBestuur@vlaanderen.be"
                {{on "change" (fn (mut this.mailto) "LoketLokaalBestuur@vlaanderen.be")}}
              >
              <span class="au-wc-radio__indicator"></span>
              Een functionaliteit, bug of probleem
            </label>
            <label class="au-wc-radio">
              <input
                type="radio"
                name="contact-subject"
                value="binnenland@vlaanderen.be"
                {{on "change" (fn (mut this.mailto) "binnenland@vlaanderen.be")}}
              >
              <span class="au-wc-radio__indicator"></span>
              Een inhoudelijke vraag over mandaten en mandatarissen
            </label>
          </div>
        </div>
      </fieldset>

      {{#if this.mailto}}
        <au-wc-link-external icon="mail" skin="button" href="mailto:{{this.mailto}}">
          Bericht versturen
        </au-wc-link-external>
      {{else}}
        <au-wc-button skin="primary" icon="mail" disabled>
          Bericht versturen
        </au-wc-button>
      {{/if}}
    </form>
  </div>
</div>

{{outlet}}
