{{page-title "Mandatendatabank Vlaanderen"}}

<au-wc-modal-container></au-wc-modal-container>

<au-wc-main-header
  brand-link="https://mandaten.lokaalbestuur.vlaanderen.be/"
  home-href="/"
  app-title="Mandatendatabank"
  contact-href="/contact"
></au-wc-main-header>

<div class="au-c-main-container" id="main">
  <div class="au-c-main-container__content au-c-main-container__content--scroll">
    <main id="content">
      {{outlet}}
    </main>
    <au-wc-main-footer>
      <au-wc-heading level="2" skin="4">
        mandaten.lokaalbestuur.vlaanderen.be is een officiële website van de Vlaamse overheid
      </au-wc-heading>
      <au-wc-content skin="small">
        <p>Uitgegeven door
          <au-wc-link-external href="https://www.vlaanderen.be/organisaties/administratieve-diensten-van-de-vlaamse-overheid/beleidsdomein-kanselarij-en-bestuur/agentschap-binnenlands-bestuur">
            Agentschap Binnenlands Bestuur
          </au-wc-link-external>
        </p>
        <ul class="au-c-list-horizontal">
          <li class="au-c-list-horizontal__item">
            <LinkTo @route="legaal.disclaimer" class="au-wc-link au-wc-link--secondary">Disclaimer</LinkTo>
          </li>
          <li class="au-c-list-horizontal__item">
            <LinkTo @route="legaal.cookieverklaring" class="au-wc-link au-wc-link--secondary">Cookieverklaring</LinkTo>
          </li>
          <li class="au-c-list-horizontal__item">
            <LinkTo @route="legaal.toegankelijkheidsverklaring" class="au-wc-link au-wc-link--secondary">Toegankelijkheid</LinkTo>
          </li>
        </ul>
      </au-wc-content>
    </au-wc-main-footer>
  </div>
</div>
